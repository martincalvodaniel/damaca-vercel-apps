{
  "name": "@@PACKAGE_NAME@@",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run --bun next build",
    "db:ensure-indexes": "bun --conditions=react-server run scripts/ensure-indexes.ts",
    "dev": "bun run --bun next dev --port @@APP_PORT@@",
    "knip": "knip",
    "start": "bun run --bun next start",
    "test": "bun test --preload ./test/setup.ts",
    "test:watch": "bun test --watch --preload ./test/setup.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/config": "catalog:",
    "better-auth": "catalog:",
    "mongodb": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "swr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "knip": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
