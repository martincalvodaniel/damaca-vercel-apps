{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "ALLOWED_EMAILS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MONGODB_DB",
        "MONGODB_URI",
        "NODE_ENV",
        "RUN_AUTH_DB_TESTS",
        "RUN_SYNC_DB_TESTS",
        "SYNC_TEST_PORT",
        "SYNC_TEST_RUN_ID",
        "VERCEL_BRANCH_URL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test": {
      "env": [
        "ALLOWED_EMAILS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MONGODB_DB",
        "MONGODB_URI",
        "NODE_ENV",
        "RUN_AUTH_DB_TESTS",
        "RUN_SYNC_DB_TESTS",
        "SYNC_TEST_PORT",
        "SYNC_TEST_RUN_ID",
        "VERCEL_BRANCH_URL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ]
    }
  }
}
