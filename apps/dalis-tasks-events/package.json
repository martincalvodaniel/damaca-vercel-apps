{
  "name": "@damaca/dalis-tasks-events",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run scripts/build.ts",
    "db:ensure-indexes": "bun --conditions=react-server run scripts/ensure-indexes.ts",
    "db:preview-personal-indexes": "bun --no-env-file --conditions=react-server scripts/preview-personal-indexes.ts",
    "db:provision-personal-indexes": "bun --no-env-file --conditions=react-server scripts/provision-personal-indexes.ts",
    "dev": "bun run --bun next dev --port 3002",
    "knip": "knip",
    "start": "bun run --bun next start",
    "test": "bun test --preload ./test/setup.ts",
    "test:sync-db": "bun run scripts/sync-db-test-runner.ts",
    "test:sync-browser": "bun run scripts/sync-db-test-runner.ts browser",
    "test:watch": "bun test --watch --preload ./test/setup.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@damaca/identity": "workspace:*",
    "better-auth": "catalog:",
    "mongodb": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "swr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vercel/config": "catalog:",
    "knip": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
