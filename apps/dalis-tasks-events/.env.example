# Hub-managed OIDC client for the current environment
HUB_URL=http://localhost:3005
HUB_OIDC_CLIENT_ID=replace-with-hub-client-id
HUB_OIDC_CLIENT_SECRET=replace-with-hub-client-secret

# Independent Better Auth session secret for this application
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3002

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/example
MONGODB_DB=example
