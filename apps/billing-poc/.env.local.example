# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/example

# better-auth — Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
ALLOWED_EMAILS=you@example.com

# WordPress API
# Base API endpoint (without trailing slash), e.g. https://example.com/wp-json
WORDPRESS_ENDPOINT=
WORDPRESS_USER=example
WORDPRESS_PASSWORD=your-wordpress-password
