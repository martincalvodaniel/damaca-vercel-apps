{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "ALLOWED_EMAILS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MONGODB_URI",
        "NODE_ENV",
        "WORDPRESS_ENDPOINT",
        "WORDPRESS_PASSWORD",
