{
  "name": "@damaca/my-next-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:ensure-indexes": "bun --conditions=react-server run scripts/ensure-indexes.ts",
    "dev": "next dev --port 3004",
    "format": "bun ../../scripts/biome-changed.ts check --write",
    "knip": "knip",
    "lint": "bun ../../scripts/biome-changed.ts check",
    "lint:fix": "bun ../../scripts/biome-changed.ts check --write",
    "start": "next start",
    "test": "bun test --preload ./test/setup.ts",
    "test:watch": "bun test --watch --preload ./test/setup.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/config": "catalog:",
    "better-auth": "catalog:",
    "mongodb": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "swr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "knip": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
