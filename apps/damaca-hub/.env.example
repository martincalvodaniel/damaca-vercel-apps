# Google OAuth credentials
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3005

# Comma-separated Google accounts with administrator access
ALLOWED_EMAILS=you@example.com

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/damaca-hub
MONGODB_DB=damaca-hub
MONGODB_INDEX_MODE=ensure

# Enable only for the Hub int deployment after its production refresh is verified.
DATABASE_REFRESH_ENABLED=false
DATABASE_REFRESH_SOURCE_URI=mongodb://127.0.0.1:27017
DATABASE_REFRESH_TARGET_URI=mongodb://127.0.0.1:27017
DATABASE_REFRESH_TARGET_DB=damaca-hub-int
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
