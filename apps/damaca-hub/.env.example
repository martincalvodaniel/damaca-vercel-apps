# Google OAuth credentials
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3005

# Comma-separated Google accounts with administrator access
ALLOWED_EMAILS=you@example.com

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/damaca-hub
MONGODB_DB=damaca-hub

# Registered OIDC consumers, one client and independent secret per app/environment.
# Each clientId, clientSecret and callback must be unique. Never use session secrets.
# Production Hub authorizes production and int consumers; use separate clients for each.
HUB_OIDC_CLIENTS=[{"appId":"pocha-score","clientId":"pocha-score-local","clientSecret":"replace-with-independent-pocha-client-secret","redirectUri":"http://localhost:3003/api/auth/callback/damaca-hub"},{"appId":"card-wars","clientId":"card-wars-local","clientSecret":"replace-with-independent-card-client-secret","redirectUri":"http://localhost:3004/api/auth/callback/damaca-hub"}]
