{
  "name": "@damaca/damaca-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run --bun next build --webpack",
    "db:ensure-indexes": "bun --conditions=react-server run scripts/ensure-indexes.ts",
    "db:migrate-public-games": "bun --conditions=react-server run scripts/migrate-public-games.ts",
    "dev": "bun run --bun next dev --port 3005",
    "knip": "knip",
    "start": "bun run --bun next start",
    "test": "bun test --preload ./test/setup.ts",
    "test:integration": "bun --conditions=react-server run src/lib/db/hub.integration.ts",
    "test:watch": "bun test --watch --preload ./test/setup.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/config": "catalog:",
    "better-auth": "catalog:",
    "mongodb": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "swr": "catalog:",
    "zod": "catalog:",
    "@damaca/identity": "workspace:*",
    "@better-auth/oauth-provider": "catalog:",
    "@damaca/database-refresh": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "knip": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
