# Google OAuth credentials
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3009

# Comma-separated Google accounts with administrator access
# Normal user access is managed in /admin and persisted in MongoDB
ALLOWED_EMAILS=you@example.com

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/example
MONGODB_DB=damaca-digest

# Optional OAuth credentials for the private ChatGPT connector.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
CHATGPT_REDIRECT_URI=

# Optional article recovery. Providers are off by default.
ARTICLE_FETCH_DIRECT_ENABLED=false
ARTICLE_FETCH_JINA_ENABLED=false
ARTICLE_FETCH_FIRECRAWL_ENABLED=false
ARTICLE_FETCH_EXTERNAL_CONFIRMATION_ENABLED=false
ARTICLE_FETCH_PROVIDER_HOSTS=
ARTICLE_FETCH_TOTAL_TIMEOUT_MS=30000
ARTICLE_FETCH_DIRECT_TIMEOUT_MS=5000
ARTICLE_FETCH_JINA_TIMEOUT_MS=10000
ARTICLE_FETCH_FIRECRAWL_TIMEOUT_MS=15000
ARTICLE_FETCH_FIRECRAWL_DAILY_LIMIT=10
JINA_API_KEY=
FIRECRAWL_API_KEY=
