{
  "name": "damaca-vercel-apps",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@noble/hashes": "2.4.0",
      "@biomejs/biome": "2.6.7",
      "@tailwindcss/postcss": "4.3.5",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.6",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vercel/config": "0.14.1",
      "better-auth": "1.7.23",
      "ask-sdk-express-adapter": "2.14.0",
      "fake-indexeddb": "6.2.8",
      "idb": "8.0.4",
      "knip": "6.45.1",
      "mongodb": "7.9.0",
      "next": "16.4.6",
      "pdf-lib": "1.17.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "server-only": "0.0.1",
      "swr": "2.5.1",
      "tailwindcss": "4.3.5",
      "typescript": "7.0.2",
      "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
      "zod": "4.6.7",
      "sharp": "0.35.5",
      "@better-auth/oauth-provider": "1.7.23",
      "@modelcontextprotocol/sdk": "1.32.2",
      "web-push": "4.0.0",
      "@types/web-push": "3.6.4"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build --concurrency=2",
    "generate:app": "turbo gen app",
    "icons:generate": "bun run scripts/generate-app-icons.ts",
    "test:generator": "bun test turbo/generators/test",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "lint": "biome check --no-errors-on-unmatched",
    "lint:fix": "biome check --write --no-errors-on-unmatched",
    "format": "biome format --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "sharp": "catalog:",
    "@turbo/gen": "2.11.11",
    "turbo": "2.11.11"
  }
}
