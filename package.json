{
  "name": "damaca-vercel-apps",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.6.2",
      "@tailwindcss/postcss": "4.3.3",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.5",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vercel/config": "0.13.0",
      "better-auth": "1.7.12",
      "fake-indexeddb": "6.2.6",
      "idb": "8.0.4",
      "knip": "6.42.1",
      "mongodb": "7.7.0",
      "next": "16.4.3",
      "pdf-lib": "1.17.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "server-only": "0.0.1",
      "swr": "2.5.1",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
      "zod": "4.6.7",
      "sharp": "0.35.5"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build --concurrency=2",
    "generate:app": "turbo gen app",
    "test:generator": "bun test turbo/generators/test",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "lint": "biome check --no-errors-on-unmatched",
    "lint:fix": "biome check --write --no-errors-on-unmatched",
    "format": "biome format --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@turbo/gen": "2.11.10",
    "turbo": "2.11.10"
  }
}
