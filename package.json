{
  "name": "damaca-vercel-apps",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.6.2",
      "@tailwindcss/postcss": "4.3.3",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.5",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vercel/config": "0.13.0",
      "better-auth": "1.7.12",
      "fake-indexeddb": "6.2.6",
      "idb": "8.0.4",
      "knip": "6.42.1",
      "mongodb": "7.7.0",
      "next": "16.4.3",
      "pdf-lib": "1.17.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "server-only": "0.0.1",
      "swr": "2.5.1",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
      "zod": "4.6.7",
      "sharp": "0.35.5"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build --concurrency=2",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "lint": "bun scripts/biome-changed.ts check",
    "lint:fix": "bun scripts/biome-changed.ts check --write",
    "format": "bun scripts/biome-changed.ts check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "2.11.10"
  }
}
