{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalEnv": ["!TURBO_TELEMETRY_DISABLED", "!VERCEL_DEPLOYMENT_ID"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**",
        "public/dalis-sw.js"
      ]
    },
    "type-check": {
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
