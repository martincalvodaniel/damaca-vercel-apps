{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalEnv": ["!TURBO_TELEMETRY_DISABLED", "!VERCEL_DEPLOYMENT_ID"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*",
        "!test/setup.ts",
        "!**/*.test.ts*",
        "!.next/**",
        "!out/**",
        "!public/dalis-sw.js",
        "!**/*.tsbuildinfo",
        "!next-env.d.ts"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**",
        "public/dalis-sw.js"
      ]
    },
    "type-check": {
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
